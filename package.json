{
  "name": "typescript-node-setup",
  "version": "1.0.0",
  "description": "Node.js project with TypeScript, Express.js, ESLint, Prettier, ts-node, nodemon and package.json environment specific scripts.",
  "main": "index.js",
  "scripts": {
    "dev": "SET NODE_ENV=development & nodemon",
    "qa": "SET NODE_ENV=qa & npm run build:start",
    "prod": "SET NODE_ENV=production & npm run build:start",
    "build:start": "rm -rf dist/ && tsc -p tsconfig.json && node -r dotenv/config dist/server.js",
    "lint:no-fix": "eslint src/**/*.ts",
    "lint": "eslint src/**/*.ts --fix",
    "prettier": "prettier --write ."
  },
  "author": "chocoscoding(https://github.com/chocoscoding)",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.10.2",
    "morgan": "^1.10.0",
    "prettier": "^3.1.1",
    "typescript-node-setup": "file:",
    "winston": "^3.17.0"
  }
}
