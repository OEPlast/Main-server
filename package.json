{
  "name": "typescript-node-setup",
  "version": "1.0.0",
  "description": "Node.js project with TypeScript, Express.js, ESLint, Prettier, ts-node, nodemon and package.json environment specific scripts.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "qa": "NODE_ENV=qa npm run build:start",
    "prod": "NODE_ENV=production npm run build:start",
    "build": "tsc --outDir dist && tsc-alias && gulp copy:mails",
    "build:start": "node dist/server.js",
    "publish:sample-events": "ts-node -r tsconfig-paths/register src/events/sampleEventsPublisher.ts",
    "start": "node dist/src/server.js",
    "lint:no-fix": "eslint src/**/*.ts",
    "lint": "eslint src/**/*.ts --fix",
    "prettier": "prettier --write .",
    "test:returns": "node test-returns-simulation.js",
    "test:returns:quick": "node test-returns-quick.js",
    "migrate:images": "ts-node -r tsconfig-paths/register scripts/migrate-images-to-webp.ts",
    "migrate:images:recovery": "ts-node -r tsconfig-paths/register scripts/migrate-images-recovery.ts",
    "generate:png": "ts-node -r tsconfig-paths/register scripts/generate-png-versions.ts",
    "fix:urls": "ts-node -r tsconfig-paths/register scripts/fix-malformed-urls.ts",
    "seed:intents": "ts-node -r tsconfig-paths/register scripts/seed-intents.ts"
  },
  "author": "chocoscoding(https://github.com/chocoscoding)",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express-fileupload": "^1.5.1",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/paystack__inline-js": "^1.0.2",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-copy": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@bunny.net/storage-sdk": "^0.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@paystack/inline-js": "^2.22.7",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.3",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "amqplib": "^0.10.8",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongodb": "^6.14.0",
    "mongoose": "^8.10.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "sharp": "^0.33.5",
    "short-uuid": "^5.2.0",
    "slugify": "^1.6.6",
    "tsc-alias": "^1.8.16",
    "winston": "^3.17.0"
  }
}
